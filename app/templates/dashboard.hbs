<div class="min-h-screen bg-slate-100 py-10">
  <div class="mx-auto max-w-4xl px-6">
    <header class="mb-10">
      <h1 class="text-3xl font-bold text-slate-900">{{this.model.salonName}}</h1>
      <p class="mt-2 text-lg text-slate-600">Bookings today: {{this.model.bookingsToday}}</p>
    </header>

    <section class="overflow-hidden rounded-xl bg-white shadow ring-1 ring-slate-200">
      <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
              Client
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
              Time
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
              Service
            </th>
            <th scope="col" class="px-6 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">
              Status
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          {{#each this.appointments as |appointment|}}
            <tr class="transition hover:bg-slate-50 {{if appointment.completed 'line-through text-gray-400' ''}}">
              <td class="whitespace-nowrap px-6 py-4 text-sm font-medium">{{appointment.clientName}}</td>
              <td class="whitespace-nowrap px-6 py-4 text-sm">{{appointment.time}}</td>
              <td class="whitespace-nowrap px-6 py-4 text-sm">{{appointment.service}}</td>
              <td class="whitespace-nowrap px-6 py-4 text-right text-sm">
                <button
                  type="button"
                  class="inline-flex items-center rounded-full border border-slate-300 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-slate-600 transition hover:border-indigo-500 hover:text-indigo-600"
                  {{on "click" (fn this.toggleCompleted appointment.id)}}
                >
                  {{if appointment.completed 'Completed' 'Mark Complete'}}
                </button>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </section>
  </div>
</div>
