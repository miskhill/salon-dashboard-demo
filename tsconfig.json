{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "salon-dashboard-demo/tests/*": ["tests/*"]
    }
  },
  "include": [
    "app/**/*.{ts,gts}",
    "tests/**/*.{ts,gts}",
    "config/**/*.d.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules"]
}
